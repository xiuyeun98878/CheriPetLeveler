-- Function to get equipped pet
local function getPet()
	char = plr.Character or plr.CharacterAdded:Wait()
	for _, tool in pairs(char:GetChildren()) do
		if tool:IsA("Tool") and tool.Name:find("Age") then
			return tool
		end
	end
end

-- Update pet label
local function updateLabel()
	local pet = getPet()
	petInfo.Text = "Equipped Pet: " .. (pet and pet.Name or "[None]")
end

-- Set Age to 50
btn1.MouseButton1Click:Connect(function()
	local pet = getPet()
	if pet then
		for i = 3, 1, -1 do
			btn1.Text = "⏳ Changing Age in " .. i .. "..."
			task.wait(1)
		end
		pet.Name = pet.Name:gsub("%[Age%s%d+%]", "[Age 50]")
		updateLabel()
	else
		btn1.Text = "⚠️ No Pet Equipped!"
		task.wait(2)
	end
	btn1.Text = "🌸 Set Age to 50"
end)

-- Add +1 Age
btn2.MouseButton1Click:Connect(function()
	local pet = getPet()
	local age = pet and tonumber(pet.Name:match("%[Age%s(%d+)%]"))
	if pet and age then
		if age >= 100 then
			btn2.Text = "⚠️ Max Age is 100!"
			task.wait(2)
		else
			for i = 3, 1, -1 do
				btn2.Text = "⏳ Adding +1 in " .. i .. "..."
				task.wait(1)
			end
			local newAge = age + 1
			pet.Name = pet.Name:gsub("%[Age%s%d+%]", "[Age " .. newAge .. "]")
			updateLabel()
		end
	else
		btn2.Text = "⚠️ No Pet Equipped!"
		task.wait(2)
	end
	btn2.Text = "🌷 Add +1 Age"
end)

-- Constant label updater
task.spawn(function()
	while true do
		updateLabel()
		task.wait(1)
	end
end)

